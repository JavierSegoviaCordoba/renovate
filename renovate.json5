{
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
  ],
  assigneesFromCodeOwners: true,
  automerge: true,
  automergeType: 'pr',
  branchConcurrentLimit: 2,
  commitBodyTable: true,
  gradle: {
    ignorePaths: [
      '**/test/**',
      '**/testFixtures/**',
      '**/testFunctional/**',
      '**/testIntegration/**',
      '**/*Test/**',
      '**/test*/**',
    ],
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackagePatterns": ["^JavierSegoviaCordoba/[Aa]ctions/"],
      "pinDigests": false
    }
  ],
  platformAutomerge: true,
  prConcurrentLimit: 1,
  rebaseWhen: 'never',
  reviewersFromCodeOwners: true,
}
